// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──

enum Role {
  STUDENT
  ADMIN
  TEACHER
}

enum ResourceType {
  LIVE_CLASS
  RECORDED_VIDEO
  PDF
  TEST
  HOMEWORK
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ClassModality {
  GROUP       // Grupal (máx 8 alumnos)
  INDIVIDUAL  // Individual (1 alumno)
  PART_DUO    // Par (2 alumnos)
}

enum StudyRhythm {
  REGULAR     // 3x/sem, 50min (L-Mi-V o Mi-J-V)
  SATURDAY    // Sabatino: 1x/sem sábado, 2h50
  INTENSIVE   // 5x/sem, 50min (L-V)
}

enum LeadSource {
  GOOGLE_ADS
  META_ADS
  INSTAGRAM
  FACEBOOK
  WHATSAPP_ORGANIC
  REFERRAL
  WEBSITE
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL_CLASS
  ENROLLED
  LOST
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ── Models ──

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique
  role           Role           @default(STUDENT)
  firstName      String?
  lastName       String?
  phone          String?
  isActive       Boolean        @default(true)
  currentLevelId String?        @db.Uuid
  currentLevel   Level?         @relation("StudentLevel", fields: [currentLevelId], references: [id])
  progress       UserProgress[]
  // Teacher relations
  teacherGroups  Level[]        @relation("TeacherGroups")
  evaluationsGiven Evaluation[] @relation("Evaluator")
  // Student relations
  evaluations    Evaluation[]   @relation("StudentEvals")
  enrollments    Enrollment[]
  attendances    Attendance[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Level {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String         // Nombre del grupo, e.g., "Grupo París", "Grupo Lyon"
  levelCode        String         @default("A1") // Nivel académico: Basico1, Basico2, Inter1, Inter2, Avanz1, Avanz2
  modality         ClassModality  @default(GROUP)
  rhythm           StudyRhythm?   // null para Individual/PartDuo (horario libre)
  schedule         String?        // Horario, e.g., "Lun, Mier, Vier · 10:00-12:00"
  maxStudents      Int            @default(8)
  zoomLink         String?        // Enlace FIJO permanente de Zoom (legacy, preferir zoomHostId)
  zoomHostId       String?        @db.Uuid
  zoomHostGroup    ZoomHost?      @relation("ZoomHostGroup", fields: [zoomHostId], references: [id])
  teacherId        String?        @db.Uuid
  teacher          User?          @relation("TeacherGroups", fields: [teacherId], references: [id])
  totalScoreTarget Int            @default(100)
  modules          Module[]
  users            User[]         @relation("StudentLevel")
  evaluations      Evaluation[]
  enrollments      Enrollment[]
  attendances      Attendance[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Module {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  levelId    String     @db.Uuid
  level      Level      @relation(fields: [levelId], references: [id])
  orderIndex Int
  title      String
  resources  Resource[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Resource {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId         String         @db.Uuid
  module           Module         @relation(fields: [moduleId], references: [id])
  type             ResourceType
  title            String
  description      String?
  url              String?        // Link de Zoom (auto-generado), YouTube ID, o URL del PDF
  zoomMeetingId    String?        // Zoom meeting ID para tracking y cancelación
  zoomHostId       String?        @db.Uuid
  zoomHost         ZoomHost?      @relation(fields: [zoomHostId], references: [id])
  scheduledAt      DateTime?      // Para clases en vivo
  durationExpected Int            // Tiempo estimado en segundos
  userProgress     UserProgress[]
  attendances      Attendance[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model UserProgress {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id])
  resourceId       String         @db.Uuid
  resource         Resource       @relation(fields: [resourceId], references: [id])
  status           ProgressStatus @default(NOT_STARTED)
  timeSpentSeconds Int            @default(0)
  score            Int?
  lastAccessedAt   DateTime       @default(now())

  @@unique([userId, resourceId])
}

// Cada ZoomHost representa una cuenta Zoom Pro independiente.
// Puede tener solo un permanentLink (Modo A) o también credentials S2S OAuth (Modo B).
model ZoomHost {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String     @unique  // Email de la cuenta Zoom
  displayName    String              // "Zoom Cuenta 1", "Profesora Marie", etc.
  permanentLink  String?             // Link fijo de Zoom (para Modo A: sin API)
  accountId      String?             // Zoom S2S OAuth Account ID (null = solo link permanente)
  clientId       String?             // Zoom S2S OAuth Client ID
  clientSecret   String?             // Zoom S2S OAuth Client Secret
  isActive       Boolean    @default(true)
  meetings       Resource[]          // Meetings creados por este host (Modo B)
  assignedGroups Level[]    @relation("ZoomHostGroup") // Grupos que usan este host
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ── Evaluaciones (Examen oral + escrito al final de cada nivel) ──

model Evaluation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation("StudentEvals", fields: [userId], references: [id])
  levelId        String   @db.Uuid
  level          Level    @relation(fields: [levelId], references: [id])
  oralScore      Float?   // 0-100
  writtenScore   Float?   // 0-100 (optional, exams are mostly oral)
  passed         Boolean  @default(false)
  evaluatedById  String?  @db.Uuid
  evaluatedBy    User?    @relation("Evaluator", fields: [evaluatedById], references: [id])
  certificateUrl String?  // URL del certificado PDF generado
  notes          String?
  createdAt      DateTime @default(now())

  @@unique([userId, levelId])
}

// ── Inscripciones y Pagos ──

model Enrollment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id])
  levelId     String        @db.Uuid
  level       Level         @relation(fields: [levelId], references: [id])
  planType    String        // "Grupal Regular", "Individual 3x/sem", etc.
  monthlyFee  Float
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean       @default(true)
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Payment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String   @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  amount       Float
  paidAt       DateTime?
  method       String?  // "PayPal", "Transferencia", "Efectivo"
  reference    String?  // Referencia o transaction ID de PayPal
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime @default(now())
}

// ── Asistencia ──

model Attendance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  resourceId String   @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id])
  levelId    String   @db.Uuid
  level      Level    @relation(fields: [levelId], references: [id])
  attended   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

// ── CRM: Prospectos / Leads ──

model Lead {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  phone            String     // WhatsApp number
  email            String?
  source           LeadSource @default(WHATSAPP_ORGANIC)
  sourceDetail     String?    // UTM campaign, ad set, keyword, etc.
  status           LeadStatus @default(NEW)
  notes            String?
  interestedIn     String?    // "Grupal Regular", "Individual", etc.
  assignedTo       String?    @db.Uuid  // Admin que atiende
  convertedToUserId String?   @db.Uuid  // User ID si se inscribió
  trialClassDate   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ── Configuración Global ──

model AppSettings {
  id              String   @id @default("global")
  googleAdsBudget Float    @default(10000) // MXN mensual
  metaAdsBudget   Float    @default(3000)  // MXN mensual
  schoolName      String   @default("Les Rois du Français")
  updatedAt       DateTime @updatedAt
}
