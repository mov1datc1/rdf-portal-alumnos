// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  TEACHER
}

enum ResourceType {
  LIVE_CLASS
  RECORDED_VIDEO
  PDF
  TEST
  HOMEWORK
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique
  role           Role           @default(STUDENT)
  firstName      String?
  lastName       String?
  isActive       Boolean        @default(true)
  currentLevelId String?        @db.Uuid
  currentLevel   Level?         @relation(fields: [currentLevelId], references: [id])
  progress       UserProgress[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Level {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   // Nombre del grupo, e.g., "Grupo París"
  levelCode        String   @default("A1") // Nivel académico: A1, A2, B1, B2, C1, C2
  schedule         String?  // Horario, e.g., "Lun, Mier, Vier · 10:00-12:00"
  totalScoreTarget Int      @default(100)
  modules          Module[]
  users            User[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Module {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  levelId    String     @db.Uuid
  level      Level      @relation(fields: [levelId], references: [id])
  orderIndex Int
  title      String
  resources  Resource[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Resource {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId         String         @db.Uuid
  module           Module         @relation(fields: [moduleId], references: [id])
  type             ResourceType
  title            String
  description      String?
  url              String?        // Link de Zoom (auto-generado), YouTube ID, o URL del PDF
  zoomMeetingId    String?        // Zoom meeting ID para tracking y cancelación
  zoomHostId       String?        @db.Uuid
  zoomHost         ZoomHost?      @relation(fields: [zoomHostId], references: [id])
  scheduledAt      DateTime?      // Para clases en vivo
  durationExpected Int            // Tiempo estimado en segundos
  userProgress     UserProgress[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model UserProgress {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id])
  resourceId       String         @db.Uuid
  resource         Resource       @relation(fields: [resourceId], references: [id])
  status           ProgressStatus @default(NOT_STARTED)
  timeSpentSeconds Int            @default(0)
  score            Int?
  lastAccessedAt   DateTime       @default(now())

  @@unique([userId, resourceId])
}

// Cada ZoomHost representa una cuenta Zoom Pro independiente con sus propias credenciales S2S OAuth
model ZoomHost {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique  // Email de la cuenta Zoom
  displayName   String              // "Zoom Cuenta 1", "Profesora Marie", etc.
  accountId     String              // Zoom S2S OAuth Account ID
  clientId      String              // Zoom S2S OAuth Client ID
  clientSecret  String              // Zoom S2S OAuth Client Secret (stored encrypted in production)
  isActive      Boolean    @default(true)
  meetings      Resource[]          // Meetings creados por este host
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
